@page "/proyecto/edit/{pId:int}"
@using TestApp.DTO.ProyectoDTO
@using TestApp.DTO.CategoriaDTO
@using TestApp.Service
@inject ProyectoService proyectoService;
@inject CategoriaService categoriaService;
@inject NavigationManager NavManager;
@rendermode InteractiveServer
<h3>Modificar Proyecto</h3>

<EditForm Model="@proyectoModificar" FormName="modProy" OnValidSubmit="Guardar">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label class="form-label" for="txtnombre">Titulo Proyecto</label>
        @*<InputHidden TValue="Int32" @bind-Value="proyectoModificar.id" />*@
        <input type="hidden" name="id" value="@proyectoModificar.id" />
        <InputText class="form-control" id="txtnombre" @bind-Value="proyectoModificar.titulo" maxlength="150" />
        <ValidationMessage For="@(() => proyectoModificar.titulo)" />
    </div>
    <div class="mb-3">
        <label class="form-label" for="txtdescripcion">Descripcion Proyecto</label>
        <InputText class="form-control" id="txtdescripcion" @bind-Value="proyectoModificar.descripcion" maxlength="250"  />
        <ValidationMessage For="@(() => proyectoModificar.descripcion)" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="txtfechainicio">Fecha Inicio</label>
        <InputDate TValue="DateTime" class="form-control" id="txtfechainicio" @bind-Value="proyectoModificar.fechaInicio"  />
        <ValidationMessage For="@(() => proyectoModificar.fechaInicio)" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="txtfechafin">Fecha Fin</label>
        <InputDate TValue="DateTime" class="form-control" id="txtfechafin" @bind-Value="proyectoModificar.fechaFin" />
        <ValidationMessage For="@(() => proyectoModificar.fechaFin)" />
    </div>

    <div class="mb-3">
        <label class="form-label" for="slctg">Categoria</label>
        <InputSelect id="slctg" @bind-Value="proyectoModificar.categoriaId" class="form-select">
            @foreach (var cat in categorias)
            {
                @if (cat.Id == proyectoModificar.categoriaId)
                {
                    <option value="@cat.Id" selected>@cat.Nombre</option>
                }
                else
                {
                    <option value="@cat.Id">@cat.Nombre</option>
                }
            }
        </InputSelect>
    </div>

    <button type="submit" class="btn btn-primary">Guardar</button>
    <button type="button" class="btn btn-dark" @onclick="Index">Regresar</button>

    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger mt-3">@errorMessage</div>
    }

</EditForm>

@code {
    private ProyectoModificarDTO proyectoModificar = new();
    private List<CategoriaSalidaDTO> categorias = new();
    private ProyectoSalidaDTO proyecto = new();

    private string errorMessage;

    [Parameter]
    public int pId { get; set; }

    private bool isFirstRender = true;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        // Solo queremos hacer esto en la primera renderización
        if (firstRender)
        {
            try
            {
                categorias = await categoriaService.GetCategoria(); // Llamamos al método para cargar productos
                proyecto = await proyectoService.GetProyectoId(pId); // Llamamos al método para cargar el proyecto
                proyectoModificar.id = proyecto.id;
                proyectoModificar.titulo = proyecto.titulo;
                proyectoModificar.descripcion = proyecto.descripcion;   
                proyectoModificar.fechaInicio = proyecto.fechaInicio;
                proyectoModificar.fechaFin = proyecto.fechaFin;
                proyectoModificar.categoriaId = proyecto.categoria.Id;
                StateHasChanged(); // Llamamos a StateHasChanged para refrescar la UI
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Error al cargar las categorias: {ex.Message}");
            }
        }
    }

    private async Task Guardar()
    {
        var resultado = await proyectoService.PutProyecto(proyectoModificar);
        if (resultado)
        {
            Index();
            return;
        }
        else
        {
            errorMessage = "Error al modificar el proyecto";
        }

    }

    void Index()
    {
        NavManager.NavigateTo("/proyecto/index", true);
    }
}
